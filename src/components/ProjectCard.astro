---
/**
 * Project card.
 *  - `hero`: full-width 16:9 media, used for the single featured project on the home page.
 *  - `compact`: 2-up grid cell for the projects index and the home grid.
 * Every card in a grid row is the same height: the card is a column flexbox,
 * the title and description are clamped to two lines, the tag row is capped
 * at two rows and pinned to the bottom.
 */
import type { Project } from '../content/site';
import { url } from '../lib/url';
import { catKey } from '../lib/category';
import Media from './Media.astro';
import Icon from './Icon.astro';

interface Props {
  project: Project;
  variant?: 'hero' | 'compact';
  /** Load the cover eagerly (the one card above the fold). Defaults to true for the hero variant. */
  eager?: boolean;
}
const { project, variant = 'hero', eager = variant === 'hero' } = Astro.props;
const href = url(`/projects/${project.slug}/`);
const linkIcon = { github: 'github', paper: 'paper', demo: 'external', video: 'play', external: 'external' } as const;

/* At most 5 tags on a card; past that, the first 4 and a "+N" chip. */
const MAX_TAGS = 5;
const visibleTags = project.tags.length > MAX_TAGS ? project.tags.slice(0, MAX_TAGS - 1) : project.tags;
const hiddenCount = project.tags.length - visibleTags.length;

const cats = [project.category, project.secondaryCategory].filter(Boolean).join('|');
const sizes =
  variant === 'hero'
    ? '(min-width: 901px) min(880px, calc(100vw - 464px)), calc(100vw - 40px)'
    : '(min-width: 901px) min(432px, calc(50vw - 232px)), (min-width: 641px) calc(50vw - 32px), calc(100vw - 40px)';
---

<article class:list={['pc', `pc--${variant}`]} data-cats={cats} data-cat={catKey(project.category)}>
  <a class="pc__media card" href={href} aria-label={`${project.title}: open project`} tabindex="-1">
    <Media label={project.media.hero} src={project.media.cover} ratio="16x9" eager={eager} sizes={sizes} />
  </a>

  <div class="pc__body">
    <p class="pc__eyebrow">
      <span class="chip chip--cat">{project.category}</span>
      <span class="label pc__eyebrow-text">{project.eyebrow}</span>
    </p>
    <h3 class="h3 pc__title">
      <a class="pc__title-link" href={href}>
        {project.title}
        <Icon name="arrow-up-right" size={14} class="pc__arrow" />
      </a>
    </h3>
    <p class="pc__context muted mono">{project.context}</p>
    {
      project.sponsors.length > 0 && (
        <p class="pc__sponsors muted">
          Sponsored by{' '}
          {project.sponsors.map((s, i) => (
            <>
              {i > 0 && (i === project.sponsors.length - 1 ? ' and ' : ', ')}
              <span class="pc__sponsor" style={`--sp-bg:${s.color.bg};--sp-text:${s.color.text}`} title={s.name}>
                {s.short}
              </span>
            </>
          ))}
        </p>
      )
    }
    <p class="pc__desc muted">{project.description}</p>

    {
      project.tags.length > 0 && (
        <ul class="chips pc__tags" aria-label="Tags">
          {visibleTags.map((t) => (
            <li class="chip chip--muted">{t}</li>
          ))}
          {hiddenCount > 0 && (
            <li class="chip chip--muted pc__more" title={project.tags.slice(visibleTags.length).join(', ')}>
              +{hiddenCount}
            </li>
          )}
        </ul>
      )
    }

    {
      variant === 'hero' && project.links.length > 0 && (
        <ul class="pc__links" aria-label="Project links">
          {project.links.map((l) => (
            <li>
              <a class="pc__link link" href={l.href} target="_blank" rel="noopener">
                <Icon name={linkIcon[l.kind]} size={13} />
                {l.label}
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</article>

<style>
  .pc {
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
    min-width: 0;
    height: 100%;
  }

  /* The link owns the radius and clipping; Media sets the 16:9 box. */
  .pc__media {
    display: block;
    flex: none;
    overflow: hidden;
    border-radius: var(--r-card);
  }

  .pc__body {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    flex: 1;
    min-width: 0;
  }

  .pc__eyebrow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.125rem;
  }

  .pc__eyebrow-text {
    color: var(--cat-text, var(--text-muted));
  }

  .pc__title {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .pc__title-link {
    display: inline;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 4px;
    transition: text-decoration-color var(--t-base) ease-out;
  }

  .pc__title-link:hover {
    text-decoration-color: var(--accent);
  }

  /* The svg lives in Icon.astro, outside this component's scope, so it needs
     :global(); global.css sets svg to display:block, which would wrap it. */
  .pc__title-link :global(.pc__arrow) {
    display: inline;
    vertical-align: -0.1em;
    margin-left: 0.25rem;
    color: var(--text-faint);
    transition:
      transform var(--t-base) ease-out,
      color var(--t-base) ease-out;
  }

  .pc__title-link:hover :global(.pc__arrow) {
    color: var(--accent);
    transform: translate(1px, -1px);
  }

  .pc__context {
    line-height: 1.5;
  }

  /* "Sponsored by [UW] and [GIX]": each name is a solid chip in the sponsor's
     brand colour with contrasting text. Same in both themes: it is the brand. */
  .pc__sponsors {
    font-size: var(--fs-small);
    line-height: 1.9;
  }

  .pc__sponsor {
    display: inline-block;
    padding: 0 0.5rem;
    border-radius: var(--r-chip);
    background: var(--sp-bg);
    color: var(--sp-text);
    font-weight: 600;
    line-height: 1.6;
  }

  .pc__desc {
    max-width: 62ch;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Pinned to the bottom; at most two rows of chips (chip ≈ 24.5px + 6px gap). */
  .pc__tags {
    margin-top: auto;
    padding-top: 0.25rem;
    max-height: calc(2 * 1.55rem + 0.375rem + 0.25rem);
    overflow: hidden;
  }

  .pc__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    margin-top: 0.25rem;
  }

  .pc__link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: var(--fs-small);
    font-weight: 500;
    color: var(--text-muted);
  }

  .pc__link:hover {
    color: var(--text);
  }

  /* ---- Hero variant ---- */
  .pc--hero .pc__title {
    font-size: 1.375rem; /* 22px */
  }

  /* ---- Compact variant ---- */
  .pc--compact {
    gap: var(--sp-2);
  }

  .pc--compact .pc__desc {
    font-size: var(--fs-small);
  }

  .pc--compact .pc__context {
    font-size: var(--fs-label);
  }
</style>
