---
import type { Project } from '../content/site';
import { withBase } from '../lib/url';

interface Props {
  project: Project;
  open?: boolean;
  eager?: boolean;
}
const { project: p, open = false, eager = false } = Astro.props;

const chips = [
  ['GitHub', p.links.github],
  ['CAD', p.links.cad],
  ['Video', p.links.video],
  ['Report', p.links.report],
].filter((c): c is [string, string] => typeof c[1] === 'string');
---

<article class="card" id={p.slug} data-status={p.status}>
  <div class="media">
    <img
      src={withBase(p.image.src)}
      alt={p.image.alt}
      width="1280"
      height="720"
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
      fetchpriority={eager ? 'high' : 'auto'}
    />
  </div>

  <div class="body">
    <div class="head">
      <h3>{p.name}</h3>
      <span class="badge">{p.status === 'in-progress' ? 'In progress' : 'Completed'}</span>
    </div>
    <p class="desc">{p.description}</p>
    <ul class="tags" aria-label="Technologies">
      {p.tags.map((t) => <li class="tag">{t}</li>)}
    </ul>
    <div class="result mono">Result: <span>{p.result}</span></div>
    {chips.length > 0 && (
      <div class="chips">
        {chips.map(([label, href]) => (
          <a class="chip" href={href} target="_blank" rel="noopener">{label} ↗</a>
        ))}
      </div>
    )}
  </div>

  <details class="more" open={open}>
    <summary>
      <span class="when-closed">▼ more</span>
      <span class="when-open">▲ less</span>
      <span class="visually-hidden"> about {p.name}</span>
    </summary>
    <div class="expanded">
      <div class="meta mono">
        <span>Sponsor: <span class="val">{p.sponsor}</span></span>
        <span>Team role: <span class="val">{p.teamRole}</span></span>
      </div>
      <div>
        <div class="label">Description</div>
        <p>{p.longDescription}</p>
      </div>
      <div>
        <div class="label">My contribution</div>
        <ul class="bullets">
          {p.contribution.map((c) => <li>{c}</li>)}
        </ul>
      </div>
      <div class="full">
        <div class="label">What I'd do differently</div>
        <p>{p.differently}</p>
      </div>
    </div>
  </details>
</article>

<style>
  .card {
    position: relative;
    display: grid;
    grid-template-columns: 40% 1fr;
    gap: 32px;
    border: 1px solid var(--line-card);
    padding: 24px;
    scroll-margin-top: 80px;
  }
  .card + .card { margin-top: 16px; }

  .media {
    aspect-ratio: 16 / 9;
    background: var(--surface-img);
    border: 1px solid var(--line-img);
    overflow: hidden;
    align-self: start;
  }
  .media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-width: 0;
    /* leave room for the absolutely positioned toggle */
    padding-right: 72px;
  }
  .head {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 14px;
  }
  h3 {
    font: 700 24px/1.2 var(--font-sans);
    color: var(--fg);
  }
  .badge {
    font: 500 10px/1 var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 5px 8px;
    color: var(--muted);
    border: 1px solid var(--line-badge);
    white-space: nowrap;
  }
  .card[data-status='in-progress'] .badge {
    color: var(--accent);
    border-color: var(--accent);
  }
  .desc {
    font-size: 15px;
    line-height: 1.55;
  }
  .result {
    font-size: 13px;
    line-height: 1.6;
    color: var(--mono);
  }
  .result span { color: var(--fg); }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .chip {
    font: 500 12px/1 var(--font-mono);
    color: var(--body);
    border: 1px solid var(--line-chip);
    padding: 7px 10px;
    text-decoration: none;
    transition: color 0.15s var(--ease), border-color 0.15s var(--ease);
  }
  .chip:hover { color: var(--fg); border-color: var(--fg); }

  /* ── expand / collapse ── */
  .more {
    grid-column: 1 / -1;
  }
  summary {
    position: absolute;
    top: 24px;
    right: 24px;
    list-style: none;
    cursor: pointer;
    font: 400 12px/1 var(--font-mono);
    color: var(--muted);
    padding: 6px 0 6px 12px;
    user-select: none;
    transition: color 0.15s var(--ease);
  }
  summary::-webkit-details-marker { display: none; }
  summary:hover { color: var(--fg); }
  .when-open { display: none; }
  .more[open] .when-open { display: inline; }
  .more[open] .when-closed { display: none; }

  .expanded {
    border-top: 1px solid var(--line);
    padding-top: 24px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 28px 48px;
    font-size: 15px;
    line-height: 1.6;
  }
  .meta {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 32px;
    font-size: 13px;
    line-height: 1.7;
    color: var(--mono);
  }
  .meta .val { color: var(--fg); }
  .full { grid-column: 1 / -1; }
  .label {
    font: 500 11px/1 var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 8px;
  }
  .bullets {
    padding-left: 18px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  /* Height + fade transition on browsers that support ::details-content;
     older browsers simply snap open/closed. */
  .more::details-content {
    height: 0;
    opacity: 0;
    overflow: clip;
    transition:
      height 0.32s var(--ease),
      opacity 0.28s var(--ease),
      content-visibility 0.32s allow-discrete;
  }
  .more[open]::details-content {
    height: auto;
    opacity: 1;
  }
  .more[open] .expanded { margin-top: 24px; }

  @media (max-width: 720px) {
    .card {
      grid-template-columns: 1fr;
      gap: 14px;
      padding: 16px;
    }
    .body { padding-right: 0; }
    h3 { font-size: 20px; }
    .badge { padding: 4px 7px; }
    .desc { font-size: 14px; }
    .tag { font-size: 10px; padding: 4px 7px; }
    .result { font-size: 12px; }
    .chip { font-size: 11px; padding: 6px 9px; }
    summary {
      position: static;
      padding: 4px 0;
    }
    .expanded {
      grid-template-columns: 1fr;
      gap: 16px;
      padding-top: 16px;
      font-size: 14px;
    }
    .meta { flex-direction: column; gap: 0; font-size: 12px; line-height: 1.8; }
    .label { font-size: 10px; margin-bottom: 6px; }
    .more[open] .expanded { margin-top: 12px; }
  }
</style>
