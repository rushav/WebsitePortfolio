---
/**
 * 2x2 grid of grey tiles: large mono figure + small two-line muted label.
 * Hidden when empty. With `category`, the figure takes that category's tint.
 */
import type { Stat, Category } from '../content/site';
import { catKey } from '../lib/category';

interface Props {
  stats?: Stat[];
  category?: Category;
}
const { stats = [], category } = Astro.props;
---

{
  stats.length > 0 && (
    <dl class="stats" aria-label="Key results" data-cat={category ? catKey(category) : undefined}>
      {stats.map((s) => (
        <div class="stats__tile card">
          <dd class="stats__value">{s.value}</dd>
          <dt class="stats__label muted">
            <span>{s.label[0]}</span>
            <span>{s.label[1]}</span>
          </dt>
        </div>
      ))}
    </dl>
  )
}

<style>
  .stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.625rem;
    margin: 0;
  }

  .stats__tile {
    display: grid;
    gap: 0.5rem;
    padding: 1rem;
    min-width: 0;
  }

  .stats__value {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 1.375rem;
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.1;
    overflow-wrap: anywhere;
    color: var(--cat-text, var(--text));
  }

  .stats__label {
    display: grid;
    font-size: var(--fs-label);
    line-height: 1.35;
  }

  @media (max-width: 900px) {
    .stats {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
