---
import { site } from '../content/site';
import { withBase } from '../lib/url';
const { hero } = site;
---

<header class="hero" id="top">
  <img
    class="photo"
    src={withBase(site.profileImage)}
    alt={`Portrait of ${site.name}`}
    width="140"
    height="140"
    decoding="async"
    fetchpriority="high"
  />
  <div class="intro">
    <h1>{site.name}</h1>
    <div class="edu mono">
      {hero.education.map((line) => <div>{line}</div>)}
    </div>
    <p class="statement">{hero.statement}</p>
    <div class="currently mono">
      Currently: <a href={hero.currently.href}>{hero.currently.text}</a>
    </div>
    <div class="actions">
      <a class="resume" href={withBase(site.resume)} download="Rushav-Dash-Resume.pdf">Download Resume</a>
      <span class="location mono"><span class="pin" aria-hidden="true"></span>{site.location}</span>
      <div class="social">
        <a class="ulink" href={`mailto:${site.email}`}>Email</a>
        <a class="ulink" href={site.linkedin} rel="me noopener" target="_blank">LinkedIn</a>
        <a class="ulink" href={site.github} rel="me noopener" target="_blank">GitHub</a>
      </div>
    </div>
    <div class="previously mono">
      Previously: <span>{hero.previously.join(' · ')}</span>
    </div>
  </div>
</header>

<style>
  .hero {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: 48px;
    align-items: start;
    padding: 96px 0 88px;
  }
  .photo {
    width: 140px;
    height: 140px;
    border-radius: 50%;
    object-fit: cover;
    background: var(--surface);
    border: 1px solid var(--line-card);
  }
  .intro {
    display: flex;
    flex-direction: column;
    gap: 20px;
    min-width: 0;
  }
  h1 {
    font: 800 64px/1 var(--font-sans);
    letter-spacing: -0.02em;
    color: var(--fg);
  }
  .edu {
    font-size: 13px;
    line-height: 1.7;
    color: var(--mono);
  }
  .statement {
    font-size: 18px;
    line-height: 1.55;
    max-width: 680px;
    color: var(--body);
  }
  .currently {
    font-size: 13px;
    color: var(--mono);
  }
  .currently a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px 24px;
    margin-top: 8px;
  }
  .resume {
    background: var(--fg);
    color: var(--bg);
    font: 700 14px var(--font-sans);
    padding: 12px 20px;
    text-decoration: none;
    transition: background-color 0.15s var(--ease);
  }
  .resume:hover { background: #fff; }
  .location {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 13px;
    color: var(--mono);
  }
  .pin {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    border: 1.5px solid var(--mono);
    display: inline-block;
  }
  .social {
    display: flex;
    gap: 18px;
  }
  .previously {
    font-size: 12px;
    color: var(--muted);
    margin-top: 8px;
  }
  .previously span { color: var(--mono); }

  @media (max-width: 720px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 18px;
      padding: 48px 0 40px;
    }
    .photo { width: 96px; height: 96px; }
    .intro { gap: 18px; }
    h1 { font-size: 42px; }
    .edu { font-size: 11px; }
    .statement { font-size: 16px; }
    .currently { font-size: 12px; line-height: 1.6; }
    .actions { flex-direction: column; align-items: stretch; gap: 18px; }
    .resume { text-align: center; padding: 14px 20px; }
    .location { font-size: 12px; }
    .social { justify-content: space-between; }
    .social .ulink { font-size: 12px; }
    .previously { font-size: 11px; line-height: 1.6; margin-top: 0; }
  }
</style>
