---
import { site } from '../content/site';
import { url, isActive } from '../lib/url';
import ThemeToggle from './ThemeToggle.astro';
import Monogram from './Monogram.astro';
import SocialRow from './SocialRow.astro';
import Icon from './Icon.astro';

interface Props {
  headline: string[];
  /** Off everywhere except /about. */
  showAvatar?: boolean;
}

const { headline, showAvatar = false } = Astro.props;
const pathname = Astro.url.pathname;
---

<aside class="sidebar">
  <div class="sidebar__sticky">
    <nav class="nav" aria-label="Primary">
      <ul class="nav__list">
        {
          site.nav.map((item) => {
            const active = isActive(pathname, item.href);
            return (
              <li>
                <a class:list={['nav__link', { 'is-active': active }]} href={url(item.href)} aria-current={active ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>
      <div class="nav__actions">
        <a class="btn btn--accent nav__resume" href={url(site.resumeHref)} target="_blank" rel="noopener">
          Resume
          <Icon name="arrow-up-right" size={14} />
        </a>
        <ThemeToggle />
      </div>
    </nav>

    <h1 class="headline">
      {headline.map((line, i) => <span class="headline__line" data-line={i + 1}>{line}</span>)}
    </h1>

    <div class="sidebar__extra">
      <slot />
    </div>

    <div class="identity">
      <SocialRow socials={site.socials} />
      <div class="identity__row">
        {
          showAvatar ? (
            <div class="media media--1x1 identity__avatar" aria-hidden="true">
              <span class="media__label">{site.about.avatar}</span>
            </div>
          ) : (
            <Monogram initials={site.initials} />
          )
        }
        <div class="identity__text">
          <p class="identity__name">{site.name}</p>
          <p class="identity__title muted">{site.title}</p>
        </div>
      </div>
      <p class="identity__desc muted">{site.descriptor}</p>
    </div>
  </div>
</aside>

<style>
  .sidebar {
    min-width: 0;
  }

  .sidebar__sticky {
    position: sticky;
    top: var(--frame-pad);
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
    min-height: calc(100vh - (var(--frame-pad) * 2) - (var(--sp-3) * 2));
  }

  /* ---- Nav ---- */
  .nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 0.75rem;
  }

  .nav__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.125rem;
    margin-left: -0.5rem; /* optical: align first label with the left edge */
  }

  .nav__link {
    display: inline-block;
    padding: 0.3rem 0.5rem;
    border-radius: var(--r-chip);
    font-size: var(--fs-small);
    font-weight: 500;
    color: var(--text-muted);
    transition:
      background-color var(--t-fast) ease-out,
      color var(--t-fast) ease-out;
  }

  .nav__link:hover {
    color: var(--text);
  }

  .nav__link.is-active {
    background: var(--surface);
    color: var(--text);
  }

  .nav__actions {
    display: flex;
    align-items: center;
    gap: 0.375rem;
  }

  .nav__resume {
    padding: 0.35rem 0.75rem;
  }

  /* ---- Headline ---- */
  .headline {
    font-size: var(--fs-display);
    font-weight: 500;
    letter-spacing: var(--ls-display);
    line-height: 1.05;
    text-wrap: balance;
  }

  .headline__line {
    display: block;
  }

  .sidebar__extra:empty {
    display: none;
  }

  /* ---- Identity ---- */
  .identity {
    display: grid;
    gap: var(--sp-2);
    margin-top: auto;
    padding-top: var(--sp-4);
  }

  .identity__row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .identity__avatar {
    width: 40px;
    flex: none;
    border-radius: 10px;
  }

  .identity__avatar::before {
    inset: 4px;
    border-radius: 6px;
  }

  .identity__avatar .media__label {
    font-size: 8px;
    padding: 0;
    letter-spacing: 0.04em;
  }

  .identity__name {
    font-weight: 600;
    letter-spacing: var(--ls-tight);
    line-height: 1.3;
  }

  .identity__title {
    font-size: var(--fs-small);
    line-height: 1.3;
  }

  .identity__desc {
    font-size: var(--fs-small);
    max-width: 28ch;
  }

  /* ---- Collapse to header ---- */
  @media (max-width: 900px) {
    .sidebar__sticky {
      position: static;
      min-height: 0;
      gap: var(--sp-3);
    }

    .identity {
      display: none; /* moves to the footer */
    }

    .headline {
      max-width: 20ch;
    }
  }
</style>
