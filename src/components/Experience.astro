---
import { experience, skills } from '../content/site';
---

<div class="list">
  {experience.map((e) => (
    <div class="entry">
      <div class="who">
        <div class="company">{e.company}</div>
        <div class="role mono">{e.title}<br />{e.dates}</div>
      </div>
      <div class="what">
        <ul class="bullets">
          {e.bullets.map((b) => <li>{b}</li>)}
        </ul>
        <ul class="tags" aria-label="Skills used">
          {e.tags.map((t) => <li class="tag">{t}</li>)}
        </ul>
      </div>
    </div>
  ))}
</div>

<div class="skills mono">
  <div class="skills-label">All skills</div>
  <div class="groups">
    {Object.entries(skills).map(([group, items]) => (
      <div><span class="group">{group}</span> · {items.join(' · ')}</div>
    ))}
  </div>
</div>

<style>
  .entry {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 40px;
    padding: 28px 0;
    border-top: 1px solid var(--line);
  }
  .company {
    font: 700 18px/1.3 var(--font-sans);
    color: var(--fg);
  }
  .role {
    font-size: 12px;
    line-height: 1.7;
    color: var(--muted);
    margin-top: 6px;
  }
  .what {
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-width: 0;
  }
  .bullets {
    padding-left: 18px;
    font-size: 15px;
    line-height: 1.6;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .skills {
    border-top: 1px solid var(--line);
    padding-top: 24px;
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 40px;
    font-size: 12px;
    line-height: 1.9;
    color: var(--mono);
  }
  .skills-label { color: var(--fg); }
  .group { color: var(--accent); }

  @media (max-width: 720px) {
    .entry, .skills {
      grid-template-columns: 1fr;
      gap: 14px;
    }
    .entry { padding: 22px 0; }
    .bullets { font-size: 14px; }
    .skills { padding-top: 20px; }
  }
</style>
