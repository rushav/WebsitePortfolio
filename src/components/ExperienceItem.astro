---
import type { Experience } from '../content/site';
import { catKey } from '../lib/category';

interface Props {
  item: Experience;
}
const { item } = Astro.props;
---

<article class="xp" data-cat={catKey(item.category)} data-build="item">
  <div class="xp__head">
    <div class="xp__titles">
      <h3 class="xp__role">{item.role}</h3>
      <p class="xp__org muted">
        {item.org}
        <span class="xp__sep" aria-hidden="true">·</span>
        {item.location}
      </p>
    </div>
    <p class="xp__dates mono muted">
      {item.start} <span aria-hidden="true">–</span><span class="sr-only">to</span> {item.end}
    </p>
  </div>

  {
    item.bullets.length > 0 && (
      <ul class="bullets xp__bullets">
        {item.bullets.map((b) => (
          <li>{b}</li>
        ))}
      </ul>
    )
  }

  {
    item.tags.length > 0 && (
      <ul class="chips xp__tags" aria-label="Skills used">
        {item.tags.map((t) => (
          <li class="chip chip--muted">{t}</li>
        ))}
      </ul>
    )
  }
</article>

<style>
  .xp {
    position: relative;
    display: grid;
    gap: var(--sp-2);
    padding-block: var(--sp-3);
    padding-left: var(--sp-2);
    border-top: 1px solid var(--border);
  }

  /* 3px rule keyed to the item's dominant category. A pseudo-element rather
     than an inset shadow so the timeline can fade it in (opacity only). */
  .xp::before {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 3px;
    background: var(--cat-text);
    transition: opacity 400ms var(--ease-out);
  }

  /* Timeline (src/scripts/timeline.ts): until the progress line reaches the
     item, its date and rule are held back; both tick in together. Only when
     the list has `.tl-ready` (JS, not reduced motion), so no-JS users see all. */
  :global(.tl-ready) > .xp:not(.is-lit)::before {
    opacity: 0;
  }

  .xp__dates {
    transition:
      opacity 300ms var(--ease-out),
      transform 300ms var(--ease-out);
  }

  :global(.tl-ready) > .xp:not(.is-lit) .xp__dates {
    opacity: 0;
    transform: translateY(4px);
  }

  .xp:last-child {
    padding-bottom: 0;
  }

  .xp__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.25rem var(--sp-2);
  }

  .xp__role {
    font-size: var(--fs-body);
    font-weight: 600;
    letter-spacing: var(--ls-tight);
    line-height: 1.4;
  }

  .xp__org {
    font-size: var(--fs-small);
  }

  .xp__sep {
    margin-inline: 0.375rem;
    color: var(--text-faint);
  }

  .xp__dates {
    font-size: var(--fs-label);
    white-space: nowrap;
  }

  .xp__bullets {
    max-width: 64ch;
  }
</style>
