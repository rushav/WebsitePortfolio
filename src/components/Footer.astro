---
import { site } from '../content/site';
import SocialRow from './SocialRow.astro';
import Monogram from './Monogram.astro';

const year = new Date().getFullYear();
---

<footer class="footer">
  {/* Identity block: hidden on desktop (it lives in the sidebar), shown ≤900px. */}
  <div class="footer__identity">
    <div class="footer__who">
      <Monogram initials={site.initials} size={36} />
      <div>
        <p class="footer__name">{site.name}</p>
        <p class="footer__title muted">{site.title}</p>
      </div>
    </div>
    <p class="footer__desc muted">{site.descriptor}</p>
  </div>

  <div class="footer__row">
    <SocialRow socials={site.socials} />
    <p class="footer__meta">
      <span>© {year} {site.copyrightName}</span>
      <span class="footer__dot" aria-hidden="true">·</span>
      <a class="link" href="https://astro.build" target="_blank" rel="noopener">built with Astro</a>
    </p>
  </div>
</footer>

<style>
  .footer {
    margin-top: var(--section-gap);
    padding-top: var(--sp-3);
    border-top: 1px solid var(--border);
    display: grid;
    gap: var(--sp-3);
  }

  .footer__identity {
    display: none;
    gap: var(--sp-2);
  }

  .footer__who {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .footer__name {
    font-weight: 600;
    letter-spacing: var(--ls-tight);
    line-height: 1.3;
  }

  .footer__title,
  .footer__desc {
    font-size: var(--fs-small);
    line-height: 1.4;
  }

  .footer__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-2);
  }

  .footer__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    color: var(--text-muted);
  }

  .footer__meta .link:hover {
    color: var(--text);
  }

  @media (max-width: 900px) {
    .footer__identity {
      display: grid;
    }
  }
</style>
