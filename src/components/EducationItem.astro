---
import type { Education } from '../content/site';
import { url } from '../lib/url';

interface Props {
  item: Education;
}
const { item } = Astro.props;
---

<article class="edu">
  {/* White tile in both themes: institution marks are drawn for white. */}
  <span class="edu__logo">
    <img src={url(item.logo)} alt={item.institution} loading="lazy" decoding="async" />
  </span>
  <div class="edu__text">
    <h3 class="edu__inst">{item.institution}</h3>
    <p class="edu__degree muted">{item.degree}</p>
  </div>
  <p class="edu__years mono muted">
    {item.start} <span aria-hidden="true">–</span><span class="sr-only">to</span> {item.end}
  </p>
</article>

<style>
  .edu {
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--sp-2);
    padding-block: var(--sp-2);
    border-top: 1px solid var(--border);
  }

  .edu:last-child {
    padding-bottom: 0;
  }

  .edu__logo {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    background: #ffffff;
    border: 1px solid var(--border);
    border-radius: 12px;
  }

  .edu__logo img {
    width: 34px;
    height: 34px;
    object-fit: contain;
  }

  .edu__inst {
    font-size: var(--fs-body);
    font-weight: 600;
    letter-spacing: var(--ls-tight);
    line-height: 1.4;
  }

  .edu__degree {
    font-size: var(--fs-small);
  }

  .edu__years {
    font-size: var(--fs-label);
    white-space: nowrap;
  }

  @media (max-width: 480px) {
    .edu {
      grid-template-columns: 56px minmax(0, 1fr);
    }

    .edu__years {
      grid-column: 2;
    }
  }
</style>
