---
/**
 * Microsoft Clarity. Rendered only in production builds, so `npm run dev`
 * never loads the tag or sends data.
 *
 * Opt-out for the site owner's own devices: visit any page with `?notrack`
 * once and that browser stops loading Clarity (localStorage.notrack = "1");
 * `?track` clears it again.
 *
 * Custom events (src/scripts/analytics.ts) are guarded by
 * `typeof window.clarity === "function"`, so they are silent no-ops when the
 * tag is absent, opted out or blocked.
 */
import { site } from '../content/site';

const id = site.analytics.clarityId;
const enabled = import.meta.env.PROD && Boolean(id);
---

{
  enabled && (
    <script is:inline define:vars={{ id }}>
      (function (c, l, a, r, i) {
        try {
          var q = new URLSearchParams(l.location.search);
          if (q.has('notrack')) localStorage.setItem('notrack', '1');
          if (q.has('track')) localStorage.removeItem('notrack');
          if (localStorage.getItem('notrack') === '1') return;
        } catch (e) {}
        // The client router keeps this <head> script across navigations; never inject twice.
        if (c[a]) return;
        c[a] = function () {
          (c[a].q = c[a].q || []).push(arguments);
        };
        var t = l.createElement(r);
        t.async = 1;
        t.src = 'https://www.clarity.ms/tag/' + i;
        var y = l.getElementsByTagName(r)[0];
        y.parentNode.insertBefore(t, y);
      })(window, document, 'clarity', 'script', id);
    </script>
  )
}
{
  enabled && (
    <script>
      import '../scripts/analytics';
    </script>
  )
}
