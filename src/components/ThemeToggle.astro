---
import Icon from './Icon.astro';
---

<button
  class="theme-toggle"
  type="button"
  data-theme-toggle
  aria-label="Switch to dark theme"
  aria-pressed="false"
>
  <span class="theme-toggle__icon theme-toggle__icon--sun"><Icon name="sun" size={15} /></span>
  <span class="theme-toggle__icon theme-toggle__icon--moon"><Icon name="moon" size={15} /></span>
</button>

<style>
  .theme-toggle {
    position: relative;
    display: inline-grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    color: var(--text-muted);
    transition:
      background-color var(--t-fast) ease-out,
      color var(--t-fast) ease-out;
  }

  .theme-toggle:hover {
    background: var(--surface);
    color: var(--text);
  }

  .theme-toggle__icon {
    grid-area: 1 / 1;
    display: grid;
    place-items: center;
    transition:
      opacity var(--t-base) ease-out,
      transform var(--t-base) ease-out;
  }

  /* Light theme shows the moon (what you'd switch to); dark shows the sun. */
  .theme-toggle__icon--sun {
    opacity: 0;
    transform: rotate(-30deg) scale(0.8);
  }

  :global(:root[data-theme='dark']) .theme-toggle__icon--sun {
    opacity: 1;
    transform: none;
  }

  :global(:root[data-theme='dark']) .theme-toggle__icon--moon {
    opacity: 0;
    transform: rotate(30deg) scale(0.8);
  }
</style>
