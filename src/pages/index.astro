---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site, featuredProjects } from '../content/site';
import { url } from '../lib/url';
import Section from '../components/Section.astro';
import AvailabilityStrip from '../components/AvailabilityStrip.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ExperienceItem from '../components/ExperienceItem.astro';
import EducationItem from '../components/EducationItem.astro';
import SkillsGrid from '../components/SkillsGrid.astro';
import IconChipRow from '../components/IconChipRow.astro';
import PubItem from '../components/PubItem.astro';
import CtaBand from '../components/CtaBand.astro';

const featured = featuredProjects();
const rest = site.projects.filter((p) => !featured.includes(p));
---

<BaseLayout title="Home" headline={site.headline}>
  <AvailabilityStrip from={site.availability.from} location={site.availability.location} />

  <Section
    id="work"
    title="Featured work"
    empty={featured.length === 0}
    action={site.projects.length > 1 ? { label: 'All projects', href: url('/projects/') } : undefined}
  >
    <div class="featured">
      {featured.map((p) => <ProjectCard project={p} variant="hero" />)}
    </div>
    {
      rest.length > 0 && (
        <div class="grid">
          {rest.map((p) => (
            <ProjectCard project={p} variant="compact" />
          ))}
        </div>
      )
    }
  </Section>

  <Section id="experience" title="Experience" empty={site.experience.length === 0}>
    <div class="list">
      {site.experience.map((item) => <ExperienceItem item={item} />)}
    </div>
  </Section>

  <Section id="education" title="Education" empty={site.education.length === 0}>
    <div class="list">
      {site.education.map((item) => <EducationItem item={item} />)}
    </div>
  </Section>

  <Section id="skills" title="Skills" empty={site.skills.length === 0}>
    <SkillsGrid skills={site.skills} />
  </Section>

  <Section id="stack" title="Tech stack" empty={site.tech.length === 0}>
    <IconChipRow items={site.tech} />
  </Section>

  <Section id="publications" title="Publications & talks" empty={site.publications.length === 0}>
    <div class="list">
      {site.publications.map((item) => <PubItem item={item} />)}
    </div>
  </Section>

  <CtaBand headline={site.cta.headline} button={site.cta.button} />
</BaseLayout>

<style>
  .featured {
    display: grid;
    gap: var(--sp-8);
  }

  .list {
    display: grid;
  }

  /* Compact cards for the non-featured projects; same 2-up grid as /projects. */
  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: stretch;
    gap: var(--sp-4) var(--sp-3);
    margin-top: var(--sp-6);
  }

  @media (max-width: 640px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
